# Tags: flow3
# On-Fail: abort
# BAN NHAP: chua chay tren MobAI. Xem trang thai bat dau trong docs/test-report.md.

open com.fpt.exe.exe_matching
wait stable 3000

# Luong 3: Leader xu ly don. Bat dau: la Leader Room 01, co 3 don demo dang cho.
tap "Nhóm của tôi"
wait stable 2000
assert exists "Nguyễn Hải Đăng"
tap "Mở vote"
wait stable 2000
tap "Vote nhận"
wait stable 2000
assert exists "Vote: 1 nhận"
tap "Nhận vào nhóm"
wait stable 3000
assert exists "Đã nhận Nguyễn Hải Đăng vào nhóm."
assert exists "2/5 thành viên"
